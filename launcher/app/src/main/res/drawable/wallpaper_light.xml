<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F4F6F9"
                android:centerColor="#E9EDF2"
                android:endColor="#DFE5EC" />
        </shape>
    </item>
    <!-- Soft vignette -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="950dp"
                android:centerX="0.5"
                android:centerY="0.4"
                android:startColor="#00000000"
                android:centerColor="#05000000"
                android:endColor="#1A000000" />
        </shape>
    </item>
</layer-list>
