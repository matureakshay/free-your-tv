<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cleaner_bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_cleaner_card"
        android:gravity="center"
        android:minWidth="440dp"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="36dp"
        android:paddingEnd="48dp"
        android:paddingBottom="36dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp">

            <ProgressBar
                android:id="@+id/cleanerProgress"
                style="?android:attr/progressBarStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/cleaner_accent" />

            <ImageView
                android:id="@+id/cleanerCheck"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_clean"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/cleanerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:singleLine="true"
            android:text="@string/cleaner_cleaning_title"
            android:textColor="@color/cleaner_text_primary"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/cleanerSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:singleLine="true"
            android:text="@string/cleaner_cleaning_subtitle"
            android:textColor="@color/cleaner_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
